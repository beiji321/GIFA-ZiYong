# 依赖与构建产物（体积大、可重新生成）
node_modules/
dist*/
# build/ 是安装器资源目录（icon.ico / installer.nsh / bmp / LICENSE.txt），需要入库
*.exe
*.asar
*.7z
*.msi

# 本地运行数据与个人配置（含账号 Cookie / 观看记录 / 标定值，禁止入库）
.workbuddy/
data/
.data-run/
settings.json
Partitions/
.env
.env.*
*.log

# 打包工具产生的中间目录（可重新生成）
.npm-cache/
.electron-dist/
.tmp/

# 本地开发启动脚本（各人环境不同，不入库）
start_dev.bat

# 编辑器 / 系统
.DS_Store
Thumbs.db
.idea/
.vscode/

# Python 字节码缓存（scripts/make-assets.py）
__pycache__/
*.pyc
