{
  "name": "genshin-route-buddy",
  "productName": "原神跟跑助手",
  "version": "0.3.0-mod",
  "description": "B站攻略视频悬浮窗：置顶于原神之上，自动读取视频里的角色朝向并在自己的小地图上标出",
  "main": "src/main.js",
  "author": "FinalLawer",
  "license": "MIT",
  "homepage": "https://github.com/beiji321/GIFA-ZiYong",
  "scripts": {
    "start": "node scripts/launch.js",
    "dist": "electron-builder --win",
    "auto:build": "node scripts/auto-build.js"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.finallawer.genshin-route-buddy",
    "productName": "原神跟跑助手",
    "asar": true,
    "npmRebuild": false,
    "asarUnpack": [
      "**/node_modules/uiohook-napi/**"
    ],
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.ico",
      "package.json",
      "!**/node_modules/uiohook-napi/libuiohook/**",
      "!**/node_modules/uiohook-napi/src/**",
      "!**/node_modules/uiohook-napi/dist/**/*.map",
      "!**/node_modules/uiohook-napi/prebuilds/darwin-*/**",
      "!**/node_modules/uiohook-napi/prebuilds/linux-*/**",
      "!**/node_modules/uiohook-napi/prebuilds/win32-arm64/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "requireAdministrator",
      "artifactName": "GenshinRouteBuddy-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "原神跟跑助手",
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "zh_CN"
      ],
      "include": "build/installer.nsh",
      "license": "build/LICENSE.txt",
      "installerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "GenshinRouteBuddy-${version}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "GenshinRouteBuddy-${version}-portable.${ext}",
      "requestExecutionLevel": "admin"
    }
  },
  "dependencies": {
    "uiohook-napi": "^1.5.5"
  }
}
